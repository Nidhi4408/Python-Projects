# Display Project Title
print("=" * 60)
print("             STUDENT MARKS ANALYZER")
print("=" * 60)

# Input Statements - Accept Student Details
student_name = input("\nEnter Student Name: ")
roll_number = input("Enter Roll Number: ")

# Input Statements - Accept Marks
subject1 = float(input("Enter marks for Subject 1: "))
subject2 = float(input("Enter marks for Subject 2: "))
subject3 = float(input("Enter marks for Subject 3: "))
subject4 = float(input("Enter marks for Subject 4: "))
subject5 = float(input("Enter marks for Subject 5: "))

# Arithmetic Operations - Calculate Total and Percentage
total = subject1 + subject2 + subject3 + subject4 + subject5
percentage = total / 5

# Conditional Statements - Grade Calculation
if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 50:
    grade = "D"
else:
    grade = "F"

# Conditional Statements - Result Calculation
if (subject1 >= 33 and subject2 >= 33 and subject3 >= 33 and
    subject4 >= 33 and subject5 >= 33):
    result = "PASS"
else:
    result = "FAIL"

# Output Statements - Display Student Report Card
print("\n" + "=" * 60)
print("               STUDENT REPORT CARD")
print("=" * 60)
print("Student Name :", student_name)
print("Roll Number  :", roll_number)
print("-" * 60)
print("Subject 1    :", subject1)
print("Subject 2    :", subject2)
print("Subject 3    :", subject3)
print("Subject 4    :", subject4)
print("Subject 5    :", subject5)
print("-" * 60)
print("Total Marks  :", total, "/500")
print("Percentage   : {:.2f}%".format(percentage))
print("Grade        :", grade)
print("Result       :", result)
print("=" * 60)


